{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrognanoHarnessToolRegistry",
  "description": "JSON Schemas for all tools registered in the Tool Gateway",
  "tools": [
    {
      "name": "read_file",
      "description": "Read contents of a file within the permitted workspace boundaries.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path to the file within the project root."
          },
          "offset": {
            "type": "integer",
            "description": "Line offset from which to start reading (0-indexed).",
            "default": 0,
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of lines to read.",
            "default": 2000,
            "minimum": 1,
            "maximum": 5000
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "list_files",
      "description": "List files and directories in a given path within the project root.",
      "parameters": {
        "type": "object",
        "properties": {
          "directory": {
            "type": "string",
            "description": "Relative directory path to inspect.",
            "default": "."
          },
          "recursive": {
            "type": "boolean",
            "description": "Whether to list recursively.",
            "default": false
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "search_code",
      "description": "Search for text or regex patterns across files in the project.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search string or regular expression."
          },
          "path": {
            "type": "string",
            "description": "Relative directory path to restrict search.",
            "default": "."
          },
          "file_pattern": {
            "type": "string",
            "description": "Glob pattern to filter filenames (e.g., '*.py').",
            "default": "*"
          }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "name": "write_file",
      "description": "Write or overwrite content to a pre-declared allowed file path.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path to the file to create or overwrite."
          },
          "content": {
            "type": "string",
            "description": "The exact full text content to write."
          },
          "overwrite": {
            "type": "boolean",
            "description": "Whether to overwrite existing file.",
            "default": true
          }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "apply_patch",
      "description": "Apply a unified diff or targeted block replacement to a file in allowed_files.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path to the file to modify."
          },
          "patch": {
            "type": "string",
            "description": "Unified diff or search/replace block patch."
          }
        },
        "required": ["path", "patch"],
        "additionalProperties": false
      }
    },
    {
      "name": "run_command",
      "description": "Execute a safe allowlisted command using structured process arguments.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The allowlisted executable binary name (e.g., 'python', 'git')."
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of command-line arguments."
          },
          "timeout": {
            "type": "integer",
            "description": "Execution timeout in seconds.",
            "default": 120,
            "maximum": 300
          }
        },
        "required": ["command", "args"],
        "additionalProperties": false
      }
    },
    {
      "name": "run_tests",
      "description": "Execute the project automated test suite in a sandboxed subprocess.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_command": {
            "type": "string",
            "description": "Test runner command (e.g., 'pytest').",
            "default": "pytest"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional arguments passed to the test runner.",
            "default": []
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "git_status",
      "description": "Check current Git working tree status.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "git_diff",
      "description": "Inspect uncommitted Git diffs in the working tree.",
      "parameters": {
        "type": "object",
        "properties": {
          "cached": {
            "type": "boolean",
            "description": "Whether to view staged diffs.",
            "default": false
          },
          "path": {
            "type": "string",
            "description": "Optional specific file path to diff."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "git_commit",
      "description": "Commit staged task changes to Git with task ID association.",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Commit message referencing task ID."
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Specific files to stage and commit."
          }
        },
        "required": ["message"],
        "additionalProperties": false
      }
    }
  ]
}
